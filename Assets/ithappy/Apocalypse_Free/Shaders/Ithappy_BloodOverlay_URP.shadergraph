    "synonyms": [],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "IthappyBloodOverlay",
    "m_FunctionSource": "",
    "m_FunctionBody": "float maskValue = lerp(Mask, 1.0 - Mask, saturate(Invert));\nfloat edge = max(Softness, 0.0001);\nfloat blood = smoothstep(Threshold - edge, Threshold + edge, maskValue);\nblood = saturate(blood * Amount);\nfloat4 tintedBase = Base * BaseTint;\nOut = float4(lerp(tintedBase.rgb, BloodColor.rgb, blood), tintedBase.a);"
}
